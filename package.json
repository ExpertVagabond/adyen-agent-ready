{
  "name": "adyen-agent-ready",
  "version": "0.1.0",
  "description": "Agent-legibility audit of Adyen's developer surfaces (docs.adyen.com, llms.txt, OpenAPI) plus an MCP server for the Adyen TEST environment.",
  "type": "module",
  "license": "MIT",
  "author": "Matthew Karsten <matthewkarstenconnects@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/ExpertVagabond/adyen-agent-ready"
  },
  "bin": {
    "adyen-agent-ready-mcp": "dist/mcp/server.js"
  },
  "files": [
    "dist",
    "data",
    "AUDIT.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "audit": "tsx src/audit/run.ts",
    "audit:offline": "tsx src/audit/run.ts --offline",
    "mcp": "tsx src/mcp/server.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@adyen/api-library": "^32.1.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
